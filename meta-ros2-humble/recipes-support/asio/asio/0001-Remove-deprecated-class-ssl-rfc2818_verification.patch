-# include "asio/ssl/impl/rfc2818_verification.ipp"
-#endif // defined(ASIO_HEADER_ONLY)
-
-#endif // !defined(ASIO_NO_DEPRECATED)
-
-#endif // ASIO_SSL_RFC2818_VERIFICATION_HPP
