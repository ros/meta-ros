From: Rob Woolley <rob.woolley@windriver.com>
Subject: [PATCH] pyproject.toml: Relax build requirements

Lower the setuptools minimum version to the 69.1.1 provided by Scarthgap.

setuptools 69.1.1 also rejects a hyphenated package name as a
tool.setuptools.package-data key because it is not a valid Python module
name:
  configuration error: `tool.setuptools.package-data` keys must be named by:
Use the '*' wildcard instead. The only package is yaml-stubs, so the
result is the same.

Upstream-Status: Inappropriate [OE-specific]
---
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,6 +1,6 @@
 [build-system]
 build-backend = "setuptools.build_meta"
-requires = ["setuptools>=82.0.1"]
+requires = ["setuptools>=69.1.1"]
 
 [project]
 name = "types-PyYAML"
@@ -53,4 +53,4 @@
 include-package-data = false
 
 [tool.setuptools.package-data]
-'yaml-stubs' = ['__init__.pyi', '_yaml.pyi', 'composer.pyi', 'constructor.pyi', 'cyaml.pyi', 'dumper.pyi', 'emitter.pyi', 'error.pyi', 'events.pyi', 'loader.pyi', 'nodes.pyi', 'parser.pyi', 'reader.pyi', 'representer.pyi', 'resolver.pyi', 'scanner.pyi', 'serializer.pyi', 'tokens.pyi', 'METADATA.toml', 'py.typed']
+'*' = ['__init__.pyi', '_yaml.pyi', 'composer.pyi', 'constructor.pyi', 'cyaml.pyi', 'dumper.pyi', 'emitter.pyi', 'error.pyi', 'events.pyi', 'loader.pyi', 'nodes.pyi', 'parser.pyi', 'reader.pyi', 'representer.pyi', 'resolver.pyi', 'scanner.pyi', 'serializer.pyi', 'tokens.pyi', 'METADATA.toml', 'py.typed']
