From 1552d49bd6f8ca97954606a0124d3aa3a8596b18 Mon Sep 17 00:00:00 2001
From: Jan Vermaete <jan.vermaete@oip.be>
Date: Sun, 23 Aug 2026 20:31:07 +0200
Subject: [PATCH 1/1] Disable fetching during configure

Upstream-Status: Inappropriate [oe specific]

Signed-off-by: Jan Vermaete <jan.vermaete@oip.be>
---
 CMakeLists.txt                                |   7 ++++---
 1 files changed, 4 insertions(+), 3 deletions(-)
 create mode 100644 foxglove-v0.19.0-cpp-aarch64-unknown-linux-gnu.zip
 create mode 100644 foxglove-v0.19.0-cpp-x86_64-unknown-linux-gnu.zip

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9285c891..2ce28216 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -66,7 +66,7 @@ if (USE_LOCAL_SDK)
     IMPORTED_LOCATION ${FOXGLOVE_SDK_ROOT}/cpp/build/libfoxglove.a
   )
 else()
-  message(STATUS "Fetching Foxglove SDK artifacts from GitHub")
+  #message(STATUS "Fetching Foxglove SDK artifacts from GitHub")
   set(FOXGLOVE_SDK_VERSION "0.19.0")
 
   if (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
@@ -78,12 +78,12 @@ else()
   else()
     message(FATAL_ERROR "Unsupported platform/architecture combination: ${CMAKE_SYSTEM_PROCESSOR}-${CMAKE_SYSTEM_NAME}")
   endif()
-  set(FOXGLOVE_SDK_URL "https://github.com/foxglove/foxglove-sdk/releases/download/sdk%2Fv${FOXGLOVE_SDK_VERSION}/foxglove-v${FOXGLOVE_SDK_VERSION}-cpp-${FOXGLOVE_SDK_PLATFORM}.zip")
+  set(FOXGLOVE_SDK_URL "${CMAKE_CURRENT_SOURCE_DIR}/foxglove-v${FOXGLOVE_SDK_VERSION}-cpp-${FOXGLOVE_SDK_PLATFORM}.zip")
 
   include(FetchContent)
   FetchContent_Declare(
     foxglove_sdk
-    URL ${FOXGLOVE_SDK_URL}
+    URL file://${FOXGLOVE_SDK_URL}
     URL_HASH SHA256=${FOXGLOVE_SDK_SHA}
   )
   FetchContent_MakeAvailable(foxglove_sdk)
-- 
