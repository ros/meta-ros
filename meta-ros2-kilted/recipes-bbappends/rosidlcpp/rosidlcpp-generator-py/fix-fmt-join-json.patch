--- a/src/rosidlcpp_generator_py/rosidlcpp_generator_py.cpp
+++ b/src/rosidlcpp_generator_py/rosidlcpp_generator_py.cpp
@@ -275,6 +275,21 @@
   return result;
 }
 
+namespace {
+// fmt 10 cannot format a std::vector<nlohmann::json> through fmt::join(). The elements are the
+// strings returned by primitive_value_to_py(), so join them as strings.
+auto join_values(const std::vector<nlohmann::json>& values, const std::string& separator) -> std::string {
+  std::string result;
+  for (const auto& value : values) {
+    if (!result.empty()) {
+      result += separator;
+    }
+    result += value.get<std::string>();
+  }
+  return result;
+}
+}  // namespace
